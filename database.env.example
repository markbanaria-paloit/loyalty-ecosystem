# Database connection for the mock loyalty platform.
#
# Copy this to `database.env` (which is gitignored) and fill in DATABASE_URL:
#
#   cp database.env.example database.env
#
# Quote the value. Sourcing an unquoted line lets the shell reinterpret any
# special character in the password.
#
# Then:
#
#   npm run db:check      confirm it connects
#   npm run dev:demo      run everything against it
#
# This project talks to Postgres directly. It does not use the Supabase JS SDK,
# so @supabase/supabase-js, @supabase/ssr and the Next.js quickstart do not
# apply — all we need is the connection string.


# ---------------------------------------------------------------------------
# Supabase — copy the string, do not hand-build it
# ---------------------------------------------------------------------------
# Project Settings → Database → Connection string → choose "Transaction pooler",
# then paste it below and replace [YOUR-PASSWORD].
#
# Copy rather than assemble: the pooler host encodes your project's region, and
# newer projects do not expose the old db.<ref>.supabase.co direct host at all.
#
# Use the TRANSACTION pooler (port 6543). Serverless opens a connection per
# invocation and exhausts a direct pool quickly; the pooler is built for that,
# and this service is compatible with it because the lock it takes is
# transaction-scoped.
#
# It should look like:
#   postgresql://postgres.<your-project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# [YOUR-PASSWORD] is the *database* password on that same page — not your
# Supabase account password. Reset it there if you don't have it.

DATABASE_URL=''


# ---------------------------------------------------------------------------
# Local Postgres instead, if you prefer
# ---------------------------------------------------------------------------
#   createdb nclub_loyalty
# DATABASE_URL=postgresql://$USER@localhost:5432/nclub_loyalty
#
# Leave DATABASE_URL empty and the platform runs in memory, resetting on every
# restart. GET /api/healthcheck reports which mode it is in.
