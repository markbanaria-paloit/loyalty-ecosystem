{
  "name": "loyalty-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "PWA loyalty app + backend BFF integrating to OpenLoyalty, with a mock OpenLoyalty server.",
  "type": "module",
  "workspaces": [
    "apps/mock-openloyalty",
    "apps/backend",
    "apps/member",
    "apps/pwa",
    "apps/merchant",
    "apps/studio"
  ],
  "scripts": {
    "dev": "sh scripts/with-env.sh concurrently -n mock,backend,member,pwa,pos,studio -c magenta,cyan,red,green,yellow,blue,white \"npm:dev:mock\" \"npm:dev:backend\" \"npm:dev:member\" \"npm:dev:pwa\" \"npm:dev:merchant\" \"npm:dev:studio\"",
    "dev:mock": "sh scripts/with-env.sh PORT=8181 npm run dev --workspace apps/mock-openloyalty",
    "dev:backend": "sh scripts/with-env.sh PORT=4000 npm run dev --workspace apps/backend",
    "dev:pwa": "npm run dev --workspace apps/pwa",
    "dev:merchant": "npm run dev --workspace apps/merchant",
    "dev:studio": "npm run dev --workspace apps/studio",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:member": "npm run dev --workspace apps/member",
    "dev:demo": "sh scripts/with-env.sh concurrently -n mock,backend,member,pos,studio -c magenta,cyan,red,yellow,blue,white \"npm:dev:mock\" \"npm:dev:backend\" \"npm:dev:member\" \"npm:dev:merchant\" \"npm:dev:studio\"",
    "contract": "npm run contract --workspace apps/backend",
    "db:check": "sh scripts/with-env.sh node scripts/db-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.33.0"
  }
}
