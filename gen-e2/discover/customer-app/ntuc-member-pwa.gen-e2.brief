  "isIsNot": {
    "is": [
      "The member's proof of identity at a tenant till — the one thing they present to earn and to redeem.",
      "A wallet: points, vouchers, tier standing and entitlements in one place, with an honest account of what changed and why.",
      "The surface where NTUC union membership becomes a visible, felt benefit rather than a database flag.",
      "A PDPA-grade consent control that a member can actually operate.",
      "Installable and usable at a counter with a queue behind you, on a bad connection."
    ],
    "isNot": [
      "A re-skin of the Open Loyalty backoffice — the engine is headless and stays that way.",
      "A transaction-initiating device. The tenant's scanner captures the sale; the member presents identity.",
      "A payment app. No card-on-file, no checkout, no payment gateway in Phase 1.",
      "A booking, ticketing or facility-reservation app — those are Phase 2 integrations.",
      "A campaign management tool. Marketers configure in the admin console and Campaign Studio, not here.",
      "A tenant reporting portal. Tenants have no self-service access in Phase 1 (BR-P1-028)."
    ]
  },

  "guidingPrinciples": [
    { "id": 1, "title": "The card opens instantly, or the programme fails at the till",           "description": "There is a queue behind the member. The membership card must be reachable in one action from a cold start and must render without a network round-trip. Everything else in the app can be slower than this." },
    { "id": 2, "title": "Never show a member a number they cannot explain",                       "description": "Balances, expiry horizons, reversals and conversion rates must each carry their reason on the same screen as the figure. A points programme loses trust at the moment a balance drops unexplained — expiry and refund reversal are both mandatory Phase 1 mechanics." },
    { "id": 3, "title": "Recognition before transaction",                                          "description": "The brand promise is 'Your Third Place Rewards You More'. If the first thing a member sees is a balance rather than an acknowledgement of who they are and what they have earned, the programme reads as a discount scheme. Tier 2 members earn no faster than Tier 1 — recognition has to do the work the earn rate does not." },
    { "id": 4, "title": "One identity, many doors",                                                 "description": "Five sign-in paths converge on one member record matched across Salesforce and NTUC HQ. The member should never have to know which door they came through, and must never be stranded when the match fails." },
    { "id": 5, "title": "Consent is a control, not a checkbox",                                     "description": "Channel-level consent is a PDPA and DNC obligation, but it is also the member's only lever over how the programme reaches them. Treat it as a first-class setting, legible and reversible, not an enrolment formality." },
    { "id": 6, "title": "Design for the rule that has not been decided yet",                        "description": "Rebate yield, tier qualification thresholds, expiry windows and the conversion table are all admin-configurable by mandate and several are still open at the client. No member-facing copy, layout or mental model may assume a specific number." }
  ],

  "regulatory": [
    { "body": "PDPA (Personal Data Protection Act, Singapore)",        "requirement": "Lawful collection, use and disclosure of member personal data; channel-level marketing consent management; data extraction to the central data warehouse must comply.", "status": "in-scope", "notes": "BR-P1-022, BR-P1-002c, BR-DI-005, BRD §17.3. Directly shapes the enrolment and profile surfaces (f2, f9)." },
    { "body": "Do Not Call (DNC) Registry, Singapore",                  "requirement": "Marketing consent handling must respect DNC registration for voice, SMS and fax channels.", "status": "in-scope", "notes": "BR-P1-022. Constrains what channel toggles can promise and how SMS consent is captured." },
    { "body": "SNDGO / GovTech — National Digital Identity (NDI)",     "requirement": "SingPass/MyInfo integration must follow NDI technical and API usage requirements, retrieving only the minimum necessary data fields.", "status": "in-scope", "notes": "BR-DI-004, BR-P1-020. Approval and API access are a named external dependency (BRD §17.2) on the critical path to 1 Dec 2026. Data minimisation directly limits what enrolment can pre-fill." },
    { "body": "ISO/IEC 27001 or SOC 2 Type II",                        "requirement": "Tenderer must hold at least one certification; supporting evidence on IAM, audit logging, cybersecurity controls, encryption in transit and at rest, vulnerability management, incident response, and backup/DR must accompany the proposal.", "status": "in-scope", "notes": "BRD §12.5. Vendor-level obligation rather than a member-surface one, but constrains auth token handling — the repository's current pattern of holding the OpenLoyalty token in localStorage is explicitly flagged as dev-grade and is not production-acceptable." },
    { "body": "NTUC Group data governance and cybersecurity standards", "requirement": "Group policies apply to all member, transaction and behavioural data; that data remains the property of NTUC Club and must be accessible via standard integration and export mechanisms.", "status": "in-scope", "notes": "BRD §6, §12.5, §17.3. Completion of the NTUC Club IT Outsource Security Requirement Checklist v3.xlsx is a proposal submission requirement — that spreadsheet is not in the ingested pack." },
    { "body": "GST treatment of points issuance and redemption",        "requirement": "To be confirmed with NTUC Club Finance and reflected in report design; earn basis must be configurable as to whether GST and service charges are included.", "status": "tbd", "notes": "BRD §13.4, BR-P1-009. Affects what 'qualifying spend' means to a member and therefore what the app can honestly state a member will earn." }
  ],

  "successMetrics": [
    { "id": "m1", "metric": "Member acquisition",       "target": "[CLIENT TO CONFIRM — no numeric target stated in the BRD]", "timeframe": "By and following go-live, 1 December 2026", "rationale": "Named Phase 1 KPI (BRD §8.9, §16). Phase 1 is explicitly about building membership scale; enrolment friction (f2) is the dominant lever on the member surface." },
