              "sourceId": "MOCK",
              "filePath": "apps/mock-openloyalty/src/routes/member.ts",
              "range": { "start": { "line": 134, "character": 0 }, "end": { "line": 144, "character": 0 } },
              "note": "The mock serves the deprecated bought-rewards route as the member's voucher wallet, which is the route the PWA would naturally build against.",
              "excerpt": "'/api/:storeCode/member/reward/bought',"
