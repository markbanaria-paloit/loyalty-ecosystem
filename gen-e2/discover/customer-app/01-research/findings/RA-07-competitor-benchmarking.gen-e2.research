{
  "meta": {
    "title": "RA-07 — Singapore loyalty competitor benchmarking",
    "studyType": "Competitor analysis / desk research (autonomous)",
    "cycle": "NTUC Club Loyalty • Discovery cycle 1 • Week 1",
    "researcher": "Gen-e2 Research Agent (desk research; human review pending)",
    "lastUpdated": "2026-08-17",
    "summary": "Five Singapore programmes benchmarked against NTUC Club Phase 1: 0.5% is confirmed as the standard entry-tier rebate across mall and airport estates (Changi Rewards Member, CapitaStar, FRx Basic), but it is the rate a repeat customer escapes — every comparator that runs tiers escalates to 1–4%, and the two Singapore clubhouse estates most structurally like NTUC Club (HomeTeamNS 1%, SAFRA an explicitly stated 2%) pay two to four times more; the defensible reading of I004 is therefore that 0.5% is not too low as an entry rate but is indefensible as a terminal one, and that the market's own answer to a flat-earn tier structure is FRx's redemption-value uplift — a mechanism BR-P1-007 already permits and the BRD has assigned to Tier 3 in Phase 2 rather than Tier 2 at launch.",

    "researchBrief": {
      "question": "How do comparable Singapore programmes — Changi Rewards above all, as the client's named benchmark (BRD §4) — solve the card, earn and redeem moments; how do they differentiate tiers; how do they disclose expiry; and where does NTUC Club's proposed rebate yield sit against the market? (Gap G07.)",
      "informs": ["RAID I004 (rebate-yield decision)", "RAID H008 (0.5% and the first-redemption KPI)", "RAID A005 (earn/redemption economics)", "RAID R004 (hollow Tier 2)", "RAID A003 (SingPass dominance)", "RAID A004 (QR presentation behaviour)", "RAID I011 (receipt upload)"],
      "method": "Desk research against each programme's own published terms and conditions, FAQs and marketing pages, corroborated where possible by operator press releases and app-store listings. No participants. No PDFs re-read — the NTUC baseline is taken from gen-e2/discover/general-references/extracted/tender-BRD-requirements.txt.",
      "outputFormat": "Comparison across five dimensions — card/earn/redeem moment, enrolment paths, tier differentiation under flat earn rates, expiry disclosure, effective rebate yield as a comparable percentage — plus a benchmarked position on I004.",
      "allSourcesAccessed": "2026-08-17"
    },

    "comparatorSelection": {
      "rationale": "NTUC Club is simultaneously two things the Singapore market treats as separate categories: a multi-property leisure estate with participating third-party tenants (like a mall or airport), and an affinity membership club with clubhouses and a captive union-adjacent base (like SAFRA or HomeTeamNS). Comparators were chosen to cover both, because the two categories price rebate yield very differently and NTUC Club's Phase 1 design borrows the earn mechanic from one and the member base from the other.",
      "selected": [
        { "programme": "Changi Rewards (Changi Airport Group)", "why": "Named by the client in BRD §4 as the usability and feature-maturity benchmark, and named again in BR-P1-001 as the model for the tenant QR-scanner earn mechanic. A multi-property retail, F&B and attraction estate with third-party tenants and >2 million members. Analysed in depth as required by the plan.", "type": "Landlord / tenant estate" },
        { "programme": "CapitaStar (CapitaLand)", "why": "The largest Singapore mall loyalty programme (>1.8 million members) across 15+ malls of third-party tenants. It is the volume benchmark for the earn moment and — since going receiptless in July 2025 — the market's clearest statement about where the card moment is heading.", "type": "Landlord / tenant estate" },
        { "programme": "FRx / Frasers Experience (Frasers Property Singapore)", "why": "A ten-plus mall estate of third-party tenants, and the only Singapore programme found that differentiates a status tier by redemption value rather than earn rate — which is precisely the mechanism BR-P1-007 mandates for NTUC Club. It is therefore the single most load-bearing comparator for the tier question.", "type": "Landlord / tenant estate" },
        { "programme": "HomeTeamNS (Rewards+ / +HPoints)", "why": "The closest structural twin to NTUC Club: an affinity membership organisation with a clubhouse estate, participating in-clubhouse tenants, facility bookings, F&B, a digital membership card in-app, and a defined eligible population. Runs a real points programme with a published conversion rate.", "type": "Affinity clubhouse estate" },
        { "programme": "SAFRA", "why": "The other Singapore affinity clubhouse estate — seven clubhouses, tenant and partner merchants, a defined eligible population — and the only comparator that publishes its rebate as a percentage in its own marketing copy, which makes it directly quotable against the BRD's own units. Also the longest-running precedent for withdrawing physical membership cards from an older membership base.", "type": "Affinity clubhouse estate" }
      ],
      "consideredAndExcluded": [
        { "programme": "Mandai Wildlife Reserve (Friends of Mandai / WildPass)", "why": "Excluded as a points comparator because it does not run one. Mandai monetises through paid annual access memberships (Friends of Mandai, from ~S$465 for a family) and a free WildPass discount tier; tiers differ by which parks are included and by F&B and retail discount rates (10–20%), not by accrual. It also ran and then dropped a coalition points programme — mandai.com states the yuu points programme 'has officially ended and yuu points will no longer be issued when spending or purchasing at Mandai Wildlife Reserve'. Retained in this record as a negative finding: Singapore attraction estates comparable to Wild Wild Wet and D'Resort monetise loyalty through access and discount entitlements, not points." },
        { "programme": "PAssion Card (People's Association)", "why": "Structurally the closest analogue to NTUC union-member auto-placement — a mass affinity card conferring status on a third-party programme. Its CapitaStar tie-up is documented but the published FAQ governing it covers a period that ended 31 August 2018, so its terms cannot be treated as current. Cited once, explicitly as historical, because the mechanism it used is directly relevant: the affinity tier was given a 1.5x earn multiplier, i.e. an earn-rate differentiator of exactly the kind BR-P1-007 forbids." },
        { "programme": "Star Rewards / Suntec+, and credit-card-linked mall programmes", "why": "Excluded as not comparable: either single-property, or the rebate is funded by a card issuer rather than the estate operator, which makes the yield figure non-comparable to a tenant-funded programme." }
      ]
    },

    "ntucBaseline": {
      "note": "The figures this benchmark is measured against, taken from the BRD extract. Cited so every comparison below is against a stated requirement, not a recollection.",
      "source": "gen-e2/discover/general-references/extracted/tender-BRD-requirements.txt",
      "earn": "BR-P1-008: base earn rate $1 qualifying spend = 1 point, admin-configurable (rate, rounding).",
      "redeem": "BR-P1-014 and §11.3/§11.4: 1,000 points = $5 voucher (Scenario 1, 0.5% yield) or $10 voucher (Scenario 2, 1% yield). Selection open.",
      "tiers": "BR-P1-004: Tier 1 – Member (default) and Tier 2 – Premium. §11.4: Tier 2 qualifying spend $1,500 min annual, or NTUC-member auto-placement (BR-P1-005).",
      "tierEarnRule": "BR-P1-007: 'Both tiers earn at the same underlying rebate yield ... tier differentiation is delivered through redemption value and ancillary benefits, not differential earn rates.'",
      "tierRedemptionValue": "§11.4: Tier 1 and Tier 2 receive the SAME voucher value per 1,000 points under both scenarios. The redemption-value differentiator BR-P1-007 names is only applied at Tier 3 — which §11.4 scopes to Phase 2.",
      "expiry": "BR-P1-011: points expire 12 months from the date earned, with automated member notification ahead of expiry; period configurable. BR-P1-016: vouchers expire 12 months from issuance by default.",
      "cardMoment": "BR-P1-001: member presents their digital membership QR code at checkout; the tenant scans it with a provided scanner; the qualifying amount is captured and credited. Explicitly 'similar to the Changi Rewards App model'.",
      "enrolment": "BR-P1-020 / BR-DI-004 / BR-DI-007: SingPass/MyInfo as baseline plus Google, Apple ID, email and mobile OTP behind a CIAM/SSO platform.",
      "membershipFee": "BR-P1-003: free to join at launch."
    },

