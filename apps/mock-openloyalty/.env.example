# Mock OpenLoyalty — the loyalty engine stand-in.
#
# NOT for production: passwords are stored in plaintext. Deploy this only to
# stand a demo up without a real OpenLoyalty tenant; point the backend at the
# real instance instead when you have one.

# Postgres connection. Set it and the store survives restarts and is shared by
# every instance of this service — which is what makes serverless viable. Leave
# it empty and the service runs in memory exactly as it used to, resetting on
# every restart.
#
# Local:    postgresql://postgres@localhost:5432/nclub_loyalty
# Supabase: the "Connection string" from Project Settings → Database
DATABASE_URL=

PORT=8181

# Admin credentials the cockpit, till and BFF authenticate with.
MOCK_OL_ADMIN_USER=admin
MOCK_OL_ADMIN_PASSWORD=admin

# Signs the JWTs this mock issues. Set a real value anywhere reachable.
MOCK_OL_JWT_SECRET=change-me
