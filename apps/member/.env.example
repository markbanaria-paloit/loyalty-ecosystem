# NTUC Club member app (Vite).
#
# `VITE_*` values are read at BUILD time and inlined into the bundle. Changing
# one in Vercel requires a redeploy, and none of them may hold a secret — every
# value here ships to the browser.

# Absolute origin of the backend BFF. Leave empty in development, where Vite
# proxies `/api`; a static deploy has no proxy, so this must be set.
VITE_API_BASE_URL=

# Live updates. Without these the app polls instead — slower, still correct.
#
# Both are public by design: the publishable key can only read the events table,
# whose rows say "member X changed" and carry no balances or names.
# Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev only: where the Vite proxy sends `/api`.
BACKEND_BASE_URL=http://localhost:4000
