# Campaign Admin (Vite).
#
# Talks to OpenLoyalty directly, as the real admin console does — not through
# the BFF. `VITE_*` values are inlined at build time and are public.

# Absolute origin of the OpenLoyalty instance. Empty in development, where Vite
# proxies `/api`.
VITE_API_BASE_URL=
VITE_STORE_CODE=default

# Dev only: where the Vite proxy sends `/api`.
OPENLOYALTY_BASE_URL=http://localhost:8181
