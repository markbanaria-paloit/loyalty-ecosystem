# Merchant till (Vite).
#
# Publishes transactions straight to OpenLoyalty, as a POS integration would.
# `VITE_*` values are inlined at build time and are public.

VITE_API_BASE_URL=
VITE_STORE_CODE=default

# Printed on every transaction as its purchase place.
VITE_PURCHASE_PLACE=Main Street Store

# Where to report that a member's points changed, so their app updates without
# waiting for its next poll. The backend holds the channel's credentials; the
# till only reports the fact. Leave empty to publish nothing.
VITE_BFF_BASE_URL=
VITE_EVENT_PUBLISH_SECRET=

# Dev only: where the Vite proxy sends `/api`.
OPENLOYALTY_BASE_URL=http://localhost:8181
