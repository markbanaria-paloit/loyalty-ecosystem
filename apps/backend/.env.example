# Backend BFF — the only seam between the apps and the loyalty platform.

PORT=4000

# Browser origins allowed to call this service. Comma-separated. On Vercel these
# are the deployed member/studio URLs; a mismatch shows up as a CORS failure in
# the browser, not an error here.
CORS_ORIGIN=http://localhost:5180,http://localhost:5176

# --- OpenLoyalty ---------------------------------------------------------
# Point this at the real instance to go live. `npm run contract` checks that
# every call this service makes exists in the vendored spec, so the swap is
# verifiable before you make it.
OPENLOYALTY_BASE_URL=http://localhost:8181
OPENLOYALTY_STORE_CODE=default

# Authentication — two schemes, both in the spec. Prefer the API key: it is sent
# as `X-AUTH-TOKEN` and skips the login round trip entirely. Leave it unset to
# use the username/password JWT flow instead.
OPENLOYALTY_API_KEY=
OPENLOYALTY_ADMIN_USER=admin
OPENLOYALTY_ADMIN_PASSWORD=admin

# Password shared by the seeded demo personas. Never leaves this service.
DEMO_PERSONA_PASSWORD=password

# --- Campaign studio -----------------------------------------------------
# Without a key the studio falls back to a deterministic offline planner, so the
# app still runs end to end.
ANTHROPIC_API_KEY=
STUDIO_MODEL=claude-opus-5
