# Backend BFF configuration
PORT=4000

# OpenLoyalty connection. In dev this points at the mock server.
# Swap OPENLOYALTY_BASE_URL to a real OpenLoyalty instance to go live.
OPENLOYALTY_BASE_URL=http://localhost:8181
OPENLOYALTY_STORE_CODE=default

# CORS origin for the PWA dev server.
# Comma-separated: the PWA and the campaign studio both call this server.
CORS_ORIGIN=http://localhost:5173,http://localhost:5176

# OpenLoyalty admin credentials (campaign studio reads/writes campaign config).
OPENLOYALTY_ADMIN_USER=admin
OPENLOYALTY_ADMIN_PASSWORD=admin

# Campaign studio agent. Without a key the studio falls back to a deterministic
# planner (see apps/backend/src/studio/offline.ts).
# ANTHROPIC_API_KEY=sk-ant-...
STUDIO_MODEL=claude-opus-5
